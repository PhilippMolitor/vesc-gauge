<globals>
	<subjects>
		<!-- BMS live stats -->
		<float name="bat_voltage" value="0" />
		<float name="bat_cells" value="0" />
		<float name="bat_cell_voltage_min" value="0" />
		<float name="bat_cell_voltage_max" value="0" />
		<float name="bat_cell_voltage_diff" value="0" />
		<int name="bat_soc_percent" value="0" min_value="0" max_value="100" />
		<int name="bat_soc_state" value="0" help="0=low 1=mid 2=high" />

		<!-- ESC live stats -->
		<float name="speed_ms" value="0" />
		<float name="speed_kmh" value="0" />
		<float name="speed_mph" value="0" />

		<int name="esc_power_watt" value="0" />
		<int name="esc_power_percent" value="0" min_value="-100" max_value="100" />
		<int
			name="esc_power_state"
			value="0"
			min_value="-1"
			max_value="2"
			help="-1 = recuperating, 0=low output, 1=mid output, 2=high output"
		/>

		<!-- Peripheral states -->
		<int name="periph_headlight" value="0" min_value="0" max_value="1" />
		<int name="periph_taillight" value="0" min_value="0" max_value="1" />
		<int name="periph_breaklight" value="0" min_value="0" max_value="1" />
		<int name="periph_turnsignal" value="0" min_value="-1" max_value="1" />

		<int name="periph_lights_enabled" value="0" min_value="0" max_value="1" />
		<int name="periph_breaklight_enabled" value="0" min_value="0" max_value="1" />

		<!-- ui settings -->
		<int name="ui_speed_unit" value="0" help="0=m/s 1=km/h 2=mph" />
	</subjects>

	<consts>
		<!-- dark color scheme (default) -->
		<color name="fg_main" value="0xfff" />
		<color name="fg_dimmed" value="0xc9c9c9" />
		<color name="bg_main" value="0x000" />
		<color name="bg_content" value="0x222" />
	</consts>

	<styles>
		<!-- Add <style> tags here -->
	</styles>

	<images>
		<!-- Add <file> or <data> tags here -->
	</images>

	<fonts>
		<!-- display font -->
		<tiny_ttf name="manrope_md" size="24" src_path="fonts/manrope-regular.ttf" />
		<tiny_ttf name="manrope_bold_md" size="24" src_path="fonts/manrope-bold.ttf" />

		<!-- big accent font -->
		<tiny_ttf name="crixus_italic_md" size="16" src_path="fonts/crixus-expanded-italic.ttf" />
		<tiny_ttf name="crixus_italic_lg" size="24" src_path="fonts/crixus-expanded-italic.ttf" />
		<tiny_ttf name="crixus_italic_xxl" size="32" src_path="fonts/crixus-expanded-italic.ttf" />
		<tiny_ttf name="crixus_italic_4xl" size="184" src_path="fonts/crixus-expanded-italic.ttf" />
	</fonts>
</globals>
