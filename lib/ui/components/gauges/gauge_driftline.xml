<component>
	<consts>
		<int name="stat_thickness" value="14" />

		<color name="power_low" value="0x009a00" />
		<color name="power_mid" value="0xd39111" />
		<color name="power_high" value="0xd02626" />

		<color name="soc_low" value="0xd02626" />
		<color name="soc_mid" value="0xd39111" />
		<color name="soc_high" value="0x009a00" />
	</consts>

	<styles>
		<style name="speed_label_main" text_color="#fg_main" />
		<style name="speed_label_unit" text_color="#fg_dimmed" />

		<style
			name="stat_arc_main"
			align="center"
			width="474"
			height="474"
			radius="0"
			arc_opa="0"
			arc_rounded="false"
		/>
		<style name="stat_arc_indicator" arc_color="#soc_high" arc_rounded="false" arc_width="#stat_thickness" />
		<style name="stat_arc_knob" bg_opa="0" />

		<style name="stat_power_low" arc_color="#power_low" />
		<style name="stat_power_mid" arc_color="#power_mid" />
		<style name="stat_power_high" arc_color="#power_high" />

		<style name="stat_soc_low" arc_color="#soc_low" />
		<style name="stat_soc_mid" arc_color="#soc_mid" />
		<style name="stat_soc_high" arc_color="#soc_high" />
	</styles>

	<view width="100%" height="100%" style_bg_color="0x000" scrollable="false">
		<!-- main speed gauge -->
		<speed_label style_text_font="crixus_italic_4xl" align="center" style_margin_left="-76" style_pad_right="38">
			<style name="speed_label_main" selector="main" />
		</speed_label>
		<speed_unit_label
			style_text_font="crixus_italic_xxl"
			align="center"
			y="110"
			style_pad_left="10"
			style_pad_right="20"
		>
			<style name="speed_label_unit" selector="main" />
		</speed_unit_label>

		<!-- left stat: power draw -->
		<lv_arc
			start_angle="100"
			end_angle="260"
			bg_start_angle="100"
			bg_end_angle="260"
			clickable="false"
			min_value="0"
			max_value="100"
			bind_value="esc_power_percent"
		>
			<style name="stat_arc_main" selector="main" />
			<style name="stat_arc_indicator" selector="indicator" />
			<style name="stat_arc_knob" selector="knob" />

			<bind_style name="stat_power_low" subject="esc_power_state" ref_value="0" selector="indicator" />
			<bind_style name="stat_power_mid" subject="esc_power_state" ref_value="1" selector="indicator" />
			<bind_style name="stat_power_high" subject="esc_power_state" ref_value="2" selector="indicator" />
		</lv_arc>

		<!-- right stat: battery SoC -->
		<lv_arc
			bg_start_angle="280"
			bg_end_angle="80"
			mode="reverse"
			clickable="false"
			min_value="0"
			max_value="100"
			bind_value="bat_soc_percent"
		>
			<style name="stat_arc_main" selector="main" />
			<style name="stat_arc_indicator" selector="indicator" />
			<style name="stat_arc_knob" selector="knob" />

			<bind_style name="stat_soc_low" subject="bat_soc_state" ref_value="0" selector="indicator" />
			<bind_style name="stat_soc_mid" subject="bat_soc_state" ref_value="1" selector="indicator" />
			<bind_style name="stat_soc_high" subject="bat_soc_state" ref_value="2" selector="indicator" />
		</lv_arc>
	</view>

	<previews>
		<preview width="480" height="480" style_radius="240">
			<set_subject name="speed_kmh" value="24.3" />
			<set_subject name="ui_speed_unit" value="1" />

			<set_subject name="bat_soc_percent" value="30" />
			<set_subject name="bat_soc_state" value="1" />

			<set_subject name="esc_power_state" value="0" />
			<set_subject name="esc_power_percent" value="40" />
		</preview>
	</previews>
</component>
